;;; secrets.el --- Per-Mac API keys, never tracked in git  -*- lexical-binding: t; -*-
;;
;; This file is INSIDE the distro's emacs.d/ but is gitignored. Each Mac
;; has its own. Pick ONE of the four methods below — uncomment the
;; relevant lines.
;;
;; The distro's gptel-setup.org reads these env vars at config time:
;;   GEMINI_API_KEY     (default backend — free tier, https://aistudio.google.com/apikey)
;;   ANTHROPIC_API_KEY  (optional)
;;   OPENAI_API_KEY     (optional)
;;   GROQ_API_KEY       (optional)
;;   GITHUB_TOKEN       (optional — for gptel GitHub Models backend + gh CLI)

;; ─────────────────────────────────────────────────────────────────────
;; Method 1: Plain — easiest, suitable for personal machines you trust.
;; ─────────────────────────────────────────────────────────────────────
;; (setenv "GEMINI_API_KEY"    "AIza...")
;; (setenv "ANTHROPIC_API_KEY" "sk-ant-...")
;; (setenv "OPENAI_API_KEY"    "sk-...")
;; (setenv "GROQ_API_KEY"      "gsk_...")
;; (setenv "GITHUB_TOKEN"      "ghp_...")

