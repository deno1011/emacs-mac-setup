# ============================================================
# Persönliche Konfiguration für alle Emacs-Setup-Skripte
# ============================================================
# Kopieren nach ~/setup-emacs-mac.conf und Werte eintragen.
# Diese Datei NICHT mit persönlichen Daten ins GitHub-Repo einchecken.

# Dein vollständiger Name wie er in git commits erscheint
# Beispiel: GIT_NAME="Jane Smith"
GIT_NAME=""

# Deine E-Mail wie sie in git commits erscheint
# Beispiel: GIT_EMAIL="jane@example.com"
GIT_EMAIL=""

# Dein GitHub-Benutzername — bestimmt woher das Repo geklont wird
# Leer lassen für lokalen Modus ohne GitHub-Sync (config.org aus Scripts-Ordner)
# Beispiel: GH_USER="janedoe"
GH_USER=""

# Privates GitHub-Repo das setup-emacs-mac.conf enthält (optional)
# Nur der Repo-Name — GH_USER wird automatisch vorangestellt (wie bei GH_REPO)
# Leer lassen wenn kein privates Conf-Repo vorhanden
# Beispiel: CONF_REPO="mac-setup-conf"  →  github.com/janedoe/mac-setup-conf
CONF_REPO=""

# Name des GitHub-Repos das deine Emacs-Config enthält
# Nur der Repo-Name, kein Username — GH_USER wird automatisch vorangestellt
# Beispiel: GH_REPO="emacs-config"  →  github.com/janedoe/emacs-config
GH_REPO="emacs-config"

# Name des Bitwarden-Eintrags der den git-crypt Schlüssel enthält
# Beispiel: BW_ITEM="emacs-git-crypt-key"
BW_ITEM="emacs-git-crypt-key"

# Name des Custom Fields in Bitwarden wo alle Schlüssel gespeichert sind
# Gilt für git-crypt Key, GitHub Token und Anthropic API Key
# Beispiel: BW_FIELD="Key"
BW_FIELD="Key"

# Name des Eintrags im Mac Keychain der das Bitwarden-Masterpasswort speichert
# Beispiel: BW_KEYCHAIN_SERVICE="bitwarden-master"
BW_KEYCHAIN_SERVICE="bitwarden-master"

# Account-Name im Mac Keychain (automatisch = Mac-Benutzername)
BW_KEYCHAIN_ACCOUNT="$USER"

# Name des Bitwarden-Eintrags mit dem GitHub CLI Token (für gh auth)
# Beispiel: BW_GH_ITEM="github-cli-token"
BW_GH_ITEM="github-cli-token"

# Name des Bitwarden-Eintrags mit dem Anthropic API Key (für gptel)
# Beispiel: BW_ANTHROPIC_ITEM="anthropic-api-key"
BW_ANTHROPIC_ITEM="anthropic-api-key"

# Name des lokalen Docker-Images (nur für Docker-Setup relevant)
# Beispiel: DOCKER_IMAGE="emacs-dev"
DOCKER_IMAGE="emacs-dev"

# Name des laufenden Docker-Containers (nur für Docker-Setup relevant)
# Beispiel: DOCKER_CONTAINER="emacs-dev"
DOCKER_CONTAINER="emacs-dev"

# Name des Docker-Volumes für persistente Paketdaten (nur für Docker-Setup relevant)
# Beispiel: DOCKER_VOLUME="emacs-home"
DOCKER_VOLUME="emacs-home"

# Pfad zum beorg iCloud-Ordner — org-Dateien werden hierhin synchronisiert
# Standardpfad wenn beorg auf dem iPhone installiert ist (nicht ändern)
BEORG_ORG_PATH="$HOME/Library/Mobile Documents/iCloud~com~appsonthemove~beorg/Documents/org"
