# ============================================================
# Personal configuration for all Emacs setup scripts
# ============================================================
# Copy to ~/setup-emacs-mac.conf and fill in your values.
# Do NOT check this file with personal data into a public GitHub repo.

# Your full name as it appears in git commits
# Example: GIT_NAME="Jane Smith"
GIT_NAME=""

# Your email as it appears in git commits
# Example: GIT_EMAIL="jane@example.com"
GIT_EMAIL=""

# Your GitHub username — determines where the repo is cloned from
# Leave empty for local mode without GitHub sync (config.org from scripts folder)
# Example: GH_USER="janedoe"
GH_USER=""

# Private GitHub repo containing setup-emacs-mac.conf (optional)
# Repo name only — GH_USER is prepended automatically (same as GH_REPO)
# Leave empty if you have no private conf repo
# Example: CONF_REPO="mac-setup-conf"  →  github.com/janedoe/mac-setup-conf
CONF_REPO=""

# Name of the GitHub repo containing your Emacs config
# Repo name only, no username — GH_USER is prepended automatically
# Example: GH_REPO="emacs-config"  →  github.com/janedoe/emacs-config
GH_REPO=""

# Name of the Bitwarden item containing the git-crypt key
# Example: BW_ITEM="emacs-git-crypt-key"
BW_ITEM=""

# Name of the custom field in Bitwarden where all keys are stored
# Applies to the git-crypt key, GitHub token and Anthropic API key
# Example: BW_FIELD="Key"
BW_FIELD=""

# Name of the Mac Keychain entry that stores the Bitwarden master password
# Example: BW_KEYCHAIN_SERVICE="bitwarden-master"
BW_KEYCHAIN_SERVICE=""

# Account name in Mac Keychain (defaults to Mac username)
BW_KEYCHAIN_ACCOUNT="$USER"

# Name of the Bitwarden item containing the GitHub CLI token (for gh auth)
# Example: BW_GH_ITEM="github-cli-token"
BW_GH_ITEM=""

# Name of the Bitwarden item containing the Anthropic API key (for gptel)
# Example: BW_ANTHROPIC_ITEM="anthropic-api-key"
BW_ANTHROPIC_ITEM=""

# Name of the local Docker image (only relevant for the Docker setup)
# Example: DOCKER_IMAGE="emacs-dev"
DOCKER_IMAGE="emacs-dev"

# Name of the running Docker container (only relevant for the Docker setup)
# Example: DOCKER_CONTAINER="emacs-dev"
DOCKER_CONTAINER="emacs-dev"

# Name of the Docker volume for persistent package data (only relevant for the Docker setup)
# Example: DOCKER_VOLUME="emacs-home"
DOCKER_VOLUME="emacs-home"

# Path to the beorg iCloud folder — org files are synced here
# Default path when beorg is installed on iPhone (do not change)
BEORG_ORG_PATH="$HOME/Library/Mobile Documents/iCloud~com~appsonthemove~beorg/Documents/org"
